# Скопируйте в .env (локальный запуск) или задайте как Secrets в GitHub (Settings → Secrets → Actions).
# Файл .env в git не попадает.

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Канал: @username публичного канала
TELEGRAM_CHANNEL=@fursat_ai
# Ваш личный chat id (узнать: написать боту @userinfobot) — для алертов и команд /status, /pause
TELEGRAM_ADMIN_CHAT=
# Ключ Claude API (console.anthropic.com) — нужен AI-редактору
ANTHROPIC_API_KEY=
# Необязательно: другая модель редактора (по умолчанию claude-opus-5-5; дешевле — claude-haiku-5-5)
# LLM_MODEL=claude-haiku-5-5
